@startuml
title FloodRun — Diagrama de Atividades (registro, consulta e análise)
skinparam ActivityFontSize 13
skinparam ConditionEndStyle hline

start
:Carregar mapa (dist_carro e dist_pe)
e histórico simulado (35 ocorrências);

repeat
  :Cidadão escolhe uma opção no menu;
  if (Opção válida?) then (não)
    :Mostrar "valor inválido";
  else (sim)
    switch (Opção)
    case (1 Registrar)
      :Cidadão informa região, data,
      chuva (mm) e categoria;
      :Validar dados;
      :Adicionar ao vetor de ocorrências;
    case (2-3 Consultar)
      :Busca sequencial por
      região ou categoria;
      :Exibir resultados;
    case (4-5 Analisar)
      :Estatísticas (contadores e acumuladores)
      ou ordenação (selection / bubble / insertion);
      :Exibir resultado;
    case (6 Risco)
      :Cidadão informa a previsão de chuva;
      :Calcular limiar e seguro de cada região;
      :Classificar BAIXO / MÉDIO / ALTO;
    case (7 Rota)
      :Cidadão informa origem, destino,
      modo (pé/carro) e previsão;
      :Calcular risco de cada região;
      if (Destino em risco ALTO?) then (sim)
        :Avisar: sem rota segura;
      else (não)
        :Dijkstra: peso = km × fator de risco
        (regiões ALTO bloqueadas);
        if (Destino alcançado?) then (sim)
          :Exibir rota, km reais
          e regiões evitadas;
        else (não)
          :Avisar: sem rota segura
          (sugerir ir a pé);
        endif
      endif
    endswitch
  endif
repeat while (Cidadão continua? (opção ≠ 0)) is (sim) not (não)
:Encerrar;
stop
@enduml
